{
  "backbone": "convnext_tiny_imagenet1k_v1",
  "feature_channels": 768,
  "seed": 42,
  "image_size": 512,
  "batch_size": 8,
  "head_epochs": 4,
  "finetune_epochs": 15,
  "head_lr": 0.001,
  "finetune_lr": 1e-05,
  "weight_decay": 0.0001,
  "lambdas": [
    0.0,
    0.1,
    0.5,
    1.0
  ],
  "selected_lambda": 0.1,
  "lambda_auc_tolerance": 0.01,
  "auc_noninferiority_margin": 0.01,
  "attention_loss": "0.5 balanced-BCE(logits) + 0.5 soft-Dice; soft area-downsampled target",
  "selection_metric": "malignant validation Pointing Game",
  "threshold_rule": "validation Youden J"
}